// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Models ────────────────────────────────────────────────────────────────

model Organization {
  id          String   @id @default(cuid())
  name        String
  slug        String?  @unique
  description String?
  logoUrl     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships         UserOrganization[]
  eventOrganizations  EventOrganization[]
  registrations       Registration[]
  orgFund             OrgFund?
  financeLedger       FinanceLedger[]
  paymentAccounts     PaymentAccount[]
  churches            Church[]
  registrantDivisions Registrant[]        @relation("RegistrantDivision")
  chatRooms           ChatRoom[]

  @@map("organizations")
}

model Church {
  id        String   @id @default(cuid())
  orgId     String
  name      String
  location  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization  Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  eventChurches EventChurch[]
  registrants   Registrant[]
  programItems  ProgramItem[]

  @@index([orgId, isActive])
  @@map("churches")
}

model EventChurch {
  eventId  String
  churchId String

  event  Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  church Church @relation(fields: [churchId], references: [id], onDelete: Cascade)

  @@id([eventId, churchId])
  @@map("event_churches")
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  isSuperAdmin  Boolean   @default(false) @map("is_super_admin")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships          UserOrganization[]
  createdEvents        Event[]              @relation("CreatedEvents")
  financeLedgerEntries FinanceLedger[]      @relation("LedgerEnteredBy")
  passwordResetTokens  PasswordResetToken[]
  sentMessages         ChatMessage[]        @relation("SentMessages")
  messageReactions     ChatMessageReaction[] @relation("MessageReactions")

  @@map("users")
}

model UserOrganization {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  orgId     String   @map("org_id")
  role      String   // "org_admin" | "officer"
  title     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId])
  @@index([orgId, role])
  @@map("user_organizations")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  type      TokenType
  expires   DateTime
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model Presentation {
  id           String   @id @default(cuid())
  title        String
  lyrics       String
  songQueue    Json     @default("[]")
  bgId         String   @default("deep-space")
  transitionId String   @default("fade")
  fontId       String   @default("inter")
  sizeId       String   @default("md")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Song {
  id        String   @id @default(cuid())
  title     String
  artist    String?
  lyrics    String?
  key       String? // e.g. "G", "A", "Bb"
  bpm       Int?
  tags      String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  serviceItems ServiceItem[]
}

model ServicePlan {
  id          String   @id @default(cuid())
  title       String
  date        DateTime
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items ServiceItem[]
}

model ServiceItem {
  id        String   @id @default(cuid())
  order     Int
  type      ItemType
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  servicePlan   ServicePlan @relation(fields: [servicePlanId], references: [id])
  servicePlanId String

  song   Song?   @relation(fields: [songId], references: [id])
  songId String?
}

model MediaFile {
  id        String    @id @default(cuid())
  name      String
  url       String
  type      MediaType
  createdAt DateTime  @default(now())
}

/// Tracks daily AI search quota per organisation (keyed by a stable org identifier).
model AiSearchQuota {
  id        String   @id @default(cuid())
  /// Stable key identifying the organisation (e.g. "org_default" until multi-tenancy is wired).
  orgKey    String   @unique
  date      String /// ISO date string YYYY-MM-DD — resets when date changes.
  used      Int      @default(0)
  updatedAt DateTime @updatedAt
}

model Event {
  id                   String      @id @default(cuid())
  title                String
  slug                 String      @unique
  description          String?     @db.Text
  type                 EventType
  customType           String?     @map("custom_type")
  venue                String?
  startDate            DateTime
  endDate              DateTime
  registrationDeadline DateTime?
  maxSlots             Int?
  status               EventStatus @default(DRAFT)
  coverImage           String?
  themeColor           String?
  paymentAccountId     String?
  createdBy            String
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  creator            User                  @relation("CreatedEvents", fields: [createdBy], references: [id])
  paymentAccount     PaymentAccount?       @relation(fields: [paymentAccountId], references: [id])
  organizations      EventOrganization[]
  eventChurches      EventChurch[]
  feeItems           EventFeeItem[]
  registrantTypes    EventRegistrantType[]
  questions          EventQuestion[]
  registrationGroups RegistrationGroup[]
  registrations      Registration[]
  financeLedger      FinanceLedger[]
  program            EventProgram?
  idTemplate         EventIdTemplate?
  chatRoom           ChatRoom?

  @@index([status, startDate])
  @@map("events")
}

/// Admin-defined fee line item for an event (e.g. "Registration Fee", "Food", "Accommodation").
/// Replaces the legacy Event.fee flat number — see RegistrationFeeItem for per-registrant selections.
model EventFeeItem {
  id         String   @id @default(cuid())
  eventId    String
  label      String
  amount     Float
  isRequired Boolean  @default(false)
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  event      Event                 @relation(fields: [eventId], references: [id], onDelete: Cascade)
  selections RegistrationFeeItem[]

  @@index([eventId])
  @@map("event_fee_items")
}

/// Admin-defined registrant type for an event (e.g. "Staff", "Pastor", "Visitor").
/// Registrants pick one during public registration — see Registration.registrantTypeId.
model EventRegistrantType {
  id        String   @id @default(cuid())
  eventId   String
  label     String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event         Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registrations Registration[]

  @@index([eventId])
  @@map("event_registrant_types")
}

enum QuestionType {
  TEXT
  CHOICE
}

/// Admin-defined registration question for an event (e.g. "Any allergies?", "T-shirt size").
/// May be a follow-up of another question via parentQuestionId + triggerOption — see
/// src/lib/eventQuestions.ts for how the resulting tree is walked.
model EventQuestion {
  id               String       @id @default(cuid())
  eventId          String
  parentQuestionId String?
  // The parent's option value that reveals this question; null for top-level questions.
  triggerOption    String?
  label            String
  type             QuestionType @default(TEXT)
  options          String[]     @default([]) // only used when type = CHOICE
  isRequired       Boolean      @default(false)
  order            Int          @default(0)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  event    Event                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  parent   EventQuestion?       @relation("QuestionFollowUps", fields: [parentQuestionId], references: [id], onDelete: Cascade)
  children EventQuestion[]      @relation("QuestionFollowUps")
  answers  RegistrationAnswer[]

  @@index([eventId])
  @@index([parentQuestionId])
  @@map("event_questions")
}

model EventProgram {
  id        String        @id @default(cuid())
  eventId   String        @unique
  status    ProgramStatus @default(DRAFT)
  totalDays Int           @default(1)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  event Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  items ProgramItem[]

  @@map("event_programs")
}

model ProgramItem {
  id            String          @id @default(cuid())
  programId     String
  day           Int             @default(1)
  type          ProgramItemType @default(ITEM)
  session       ProgramSession?
  order         Int
  title         String
  description   String?         @db.Text
  time          String?
  churchId      String?
  presenterName String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  program EventProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  church  Church?      @relation(fields: [churchId], references: [id])

  @@index([programId, day, order])
  @@map("program_items")
}

model Registrant {
  id                    String   @id @default(cuid())
  fullName              String
  nickname              String?
  email                 String   @unique
  phone                 String
  birthday              DateTime
  address               String   @db.Text
  photoUrl              String?  @map("photo_url")
  // Legacy text fields — kept for backward compat with existing data
  church                String?
  organization          String?
  // FK fields — used for new registrations
  churchId              String?
  divisionOrgId         String?
  emergencyContactName  String
  emergencyContactPhone String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  churchRef     Church?        @relation(fields: [churchId], references: [id])
  divisionOrg   Organization?  @relation("RegistrantDivision", fields: [divisionOrgId], references: [id])
  registrations Registration[]

  @@map("registrants")
}

model RegistrationGroup {
  id               String   @id @default(cuid())
  eventId          String
  confirmationCode String   @unique
  submittedByName  String
  submittedByEmail String
  headcount        Int
  createdAt        DateTime @default(now())

  event         Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registrations Registration[]
  sharedPayment Payment?       @relation("GroupPayment")

  @@index([eventId])
  @@map("registration_groups")
}

model Registration {
  id                  String             @id @default(cuid())
  eventId             String
  registrantId        String
  groupId             String
  orgId               String
  status              RegistrationStatus @default(PENDING)
  paymentIntent       PaymentIntent
  approvedBy          String?
  approvedAt          DateTime?
  rejectedBy          String?
  rejectedAt          DateTime?
  notes               String?            @db.Text
  registrantTypeId    String?
  // Snapshot — survives later edits/deletion of the source EventRegistrantType
  registrantTypeLabel String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  event        Event                 @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registrant   Registrant            @relation(fields: [registrantId], references: [id])
  group        RegistrationGroup     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  organization Organization          @relation(fields: [orgId], references: [id])
  payment      Payment?              @relation("IndividualPayment")
  feeItems     RegistrationFeeItem[]
  registrantType EventRegistrantType? @relation(fields: [registrantTypeId], references: [id], onDelete: SetNull)
  answers      RegistrationAnswer[]

  @@unique([eventId, registrantId])
  @@index([eventId, status])
  @@index([orgId, status])
  @@index([groupId])
  @@map("registrations")
}

/// Snapshot of a fee item a registrant selected at submission time — label/amount are
/// copied so later edits or deletion of the source EventFeeItem don't change past totals.
model RegistrationFeeItem {
  id             String       @id @default(cuid())
  registrationId String
  feeItemId      String
  label          String
  amount         Float
  createdAt      DateTime     @default(now())

  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  feeItem        EventFeeItem @relation(fields: [feeItemId], references: [id])

  @@unique([registrationId, feeItemId])
  @@map("registration_fee_items")
}

/// Snapshot of a registrant's answer at submission time — questionLabel is copied so later
/// edits or deletion of the source EventQuestion (questionId nullable + SetNull) don't change
/// past answers.
model RegistrationAnswer {
  id             String   @id @default(cuid())
  registrationId String
  questionId     String?
  questionLabel  String
  answer         String   @db.Text
  createdAt      DateTime @default(now())

  registration Registration   @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  question     EventQuestion? @relation(fields: [questionId], references: [id], onDelete: SetNull)

  @@index([registrationId])
  @@map("registration_answers")
}

model Payment {
  id          String        @id @default(cuid())
  amount      Float
  method      PaymentMethod
  receiptUrl  String?
  referenceNo String?
  status      PaymentStatus @default(PENDING)
  verifiedBy  String?
  verifiedAt  DateTime?
  notes       String?       @db.Text
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  registrationId String?       @unique
  registration   Registration? @relation("IndividualPayment", fields: [registrationId], references: [id])

  groupId String?            @unique
  group   RegistrationGroup? @relation("GroupPayment", fields: [groupId], references: [id])

  @@map("payments")
}

model EventOrganization {
  id           String            @id @default(cuid())
  eventId      String
  orgId        String
  role         EventOrgRole      @default(HOST)
  inviteStatus EventInviteStatus @default(ACCEPTED)
  invitedBy    String?
  respondedAt  DateTime?
  createdAt    DateTime          @default(now())

  event        Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [orgId], references: [id])

  @@unique([eventId, orgId])
  @@index([orgId, inviteStatus])
  @@map("event_organizations")
}

model PaymentAccount {
  id            String        @id @default(cuid())
  orgId         String
  method        PaymentMethod
  label         String
  accountName   String
  accountNumber String
  bankName      String?
  qrCodeUrl     String?
  instructions  String?       @db.Text
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  organization Organization @relation(fields: [orgId], references: [id])
  events       Event[]

  @@index([orgId, isActive])
  @@map("payment_accounts")
}

model OrgFund {
  id             String   @id @default(cuid())
  orgId          String   @unique
  initialBalance Float    @default(0)
  currency       String   @default("PHP")
  notes          String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [orgId], references: [id])

  @@map("org_funds")
}

model FinanceLedger {
  id             String           @id @default(cuid())
  orgId          String
  eventId        String?
  type           FinanceEntryType
  category       FinanceCategory
  amount         Float
  description    String
  referenceId    String?
  customCategory String?          @map("custom_category")
  payee          String?
  requestedBy    String?
  receiptUrl     String?
  enteredBy      String
  date           DateTime
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization  Organization @relation(fields: [orgId], references: [id])
  event         Event?       @relation(fields: [eventId], references: [id])
  enteredByUser User         @relation("LedgerEnteredBy", fields: [enteredBy], references: [id])

  @@index([orgId, type])
  @@index([orgId, date])
  @@index([eventId])
  @@map("finance_ledger")
}

// ─── Chat ──────────────────────────────────────────────────────────────────

model ChatRoom {
  id        String       @id @default(cuid())
  name      String
  type      ChatRoomType
  orgId     String
  eventId   String?      @unique
  createdAt DateTime     @default(now())

  organization Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  event        Event?        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  messages     ChatMessage[]

  @@index([orgId, type])
  @@map("chat_rooms")
}

model ChatMessage {
  id        String   @id @default(cuid())
  roomId    String
  senderId  String
  content   String   @db.Text
  createdAt DateTime @default(now())

  room      ChatRoom              @relation(fields: [roomId], references: [id], onDelete: Cascade)
  sender    User                  @relation("SentMessages", fields: [senderId], references: [id])
  reactions ChatMessageReaction[]

  @@index([roomId, createdAt])
  @@map("chat_messages")
}

model ChatMessageReaction {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  message ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User        @relation("MessageReactions", fields: [userId], references: [id])

  @@unique([messageId, userId, emoji])
  @@index([messageId])
  @@map("chat_message_reactions")
}

// ─── Enums ─────────────────────────────────────────────────────────────────

enum ItemType {
  SONG
  SCRIPTURE
  ANNOUNCEMENT
  MEDIA
  PRAYER
  OFFERING
}

enum MediaType {
  IMAGE
  VIDEO
  AUDIO
}

enum EventType {
  CAMP
  FELLOWSHIP
  SEMINAR
  WORSHIP_NIGHT
  OTHER
}

enum EventStatus {
  DRAFT
  OPEN
  CLOSED
  CANCELLED
  COMPLETED
}

enum EventOrgRole {
  HOST
  COLLABORATOR
}

enum EventInviteStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum RegistrationStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum PaymentIntent {
  CASH
  ONLINE
  FREE
}

enum PaymentMethod {
  CASH
  GCASH
  MAYA
  BANK_TRANSFER
  OTHER
}

enum PaymentStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum FinanceEntryType {
  INCOME
  EXPENSE
}

enum ProgramStatus {
  DRAFT
  PENDING
  FINAL
}

enum ProgramItemType {
  SESSION_HEADER
  ITEM
}

enum ProgramSession {
  MORNING
  AFTERNOON
  EVENING
}

model EventIdTemplate {
  id            String   @id @default(cuid())
  eventId       String   @unique @map("event_id")
  backgroundUrl String   @map("background_url")
  sizeId        String   @default("cr80") @map("size_id")
  layoutId      String   @default("gradient-bottom") @map("layout_id")
  layoutFields  Json     @map("layout_fields")
  overlayColor  String   @default("#000000") @map("overlay_color")
  textColor     String   @default("#ffffff") @map("text_color")
  fontFamily    String   @default("Poppins") @map("font_family")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("event_id_templates")
}

enum FinanceCategory {
  // Income categories
  REGISTRATION
  OFFERTORY
  DONATION
  OTHER_INCOME
  // Expense categories
  PRIZES
  DESIGN_PRINTING
  FOOD_BEVERAGE
  TRANSPORTATION
  VENUE
  SUPPLIES
  MARKETING
  OTHER_EXPENSE
}

enum TokenType {
  PASSWORD_SETUP
  PASSWORD_RESET
}

enum ChatRoomType {
  ORG
  EVENT
}
